{
  "kind": "collectionType",
  "collectionName": "resources",
  "info": {
    "singularName": "resource",
    "pluralName": "resources",
    "displayName": "Resource",
    "description": "Downloadable files and off-site long-form video, including webinars"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "kind": {
      "type": "enumeration",
      "enum": ["Download", "Webinar", "Video", "Link"],
      "default": "Download",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "file": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images", "files", "videos", "audios"]
    },
    "url": {
      "type": "string"
    },
    "figure": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "publishedDate": {
      "type": "date"
    }
  }
}
