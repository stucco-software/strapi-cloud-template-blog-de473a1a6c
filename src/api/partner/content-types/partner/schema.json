{
  "kind": "collectionType",
  "collectionName": "partners",
  "info": {
    "singularName": "partner",
    "pluralName": "partners",
    "displayName": "Partner",
    "description": "A partner or sponsor organization"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["images"]
    },
    "url": {
      "type": "string"
    },
    "sponsorshipLevel": {
      "type": "enumeration",
      "enum": ["Platinum", "Gold", "Silver", "Bronze"]
    },
    "chapter": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::chapter.chapter"
    },
    "tier": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::partner-tier.partner-tier",
      "inversedBy": "partners"
    }
  }
}
