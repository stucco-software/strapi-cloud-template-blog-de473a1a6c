{
  "kind": "collectionType",
  "collectionName": "events",
  "info": {
    "singularName": "event",
    "pluralName": "events",
    "displayName": "Event"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "startsAt": {
      "type": "datetime"
    },
    "endsAt": {
      "type": "datetime"
    },
    "description": {
      "type": "blocks"
    },
    "memberPrice": {
      "type": "decimal"
    },
    "publicPrice": {
      "type": "decimal"
    },
    "location": {
      "type": "string"
    },
    "locationUrl": {
      "type": "string"
    },
    "figure": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "chapter": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::chapter.chapter",
      "inversedBy": "events"
    }
  }
}
